// Pulse — construction project tracker
// Multi-project data model. Financial figures are stored as Float (the source
// report figures are already rounded); status/priority/workstream are Strings
// validated at the app layer (see src/lib/constants.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used for schema push / migrations. For a
  // pooled provider like Neon/Supabase set this to the DIRECT connection string;
  // for a plain local Postgres set it equal to DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---- Auth / team ----------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  initials     String
  role         String // job title, display only
  access       String   @default("contributor") // admin | contributor | viewer
  passwordHash String
  createdAt    DateTime @default(now())

  devices DeviceToken[]
}

// APNs/FCM device tokens for push notifications, one row per device per user.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("ios")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---- Core project ---------------------------------------------------------
model Project {
  id         String   @id @default(cuid())
  name       String
  code       String?
  client     String?
  location   String?
  asOfDate   DateTime?
  reportDate DateTime?

  // Team roles (denormalized labels from the weekly report header)
  projectExec       String?
  construction      String?
  projectManagement String?
  coordinator       String?

  // Weather days
  weatherContractDays   Int?
  weatherUsedThisPeriod Int?
  weatherTotalUsed      Int?
  weatherBalance        Int?

  // Submittals
  submittalsSubmitted  Int?
  submittalsReturned   Int?
  submittalsOutstanding Int?

  createdAt DateTime @default(now())

  tasks           Task[]
  financials      FinancialSnapshot[]
  financialLineItems FinancialLineItem[]
  pcoSummary      PcoSummary?
  pcoBuckets      PcoStatusBucket[]
  pcoReasons      PcoReason[]
  pcoFunding      PcoFundingSource[]
  pcos            Pco[]
  allowances      Allowance[]
  commitments     Commitment[]
  milestones      Milestone[]
  designIssuances DesignIssuance[]
  lookahead       LookaheadItem[]
  weeklyStatus    WeeklyStatus[]
  attachments     Attachment[]
  imports         ImportBatch[]
}

// Per-project custom rows for the Hard Cost Budget → Forecast summary. Each
// project shapes its own breakdown (labels/order); the 5 canonical roll-up
// figures stay on FinancialSnapshot so the Development Dashboard is unaffected.
// Admins manage the structure; contributors edit the values.
model FinancialLineItem {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section   String   @default("Hard Cost Budget → Forecast") // group header
  label     String
  value     Float?
  emphasis  Boolean  @default(false) // bold subtotal rows (Current Budget, Projected Final…)
  order     Int      @default(0)
  // When set, this row is a window into a FinancialSnapshot field: its value is
  // read from (and written back to) that field, so imports and the Edit
  // financials modal flow into the summary automatically. Null = a free custom
  // row that stores its own `value`.
  field     String?
  // When set, this row is one of the fixed roll-up figures the Development
  // Dashboard aggregates. Such rows are protected (no delete/reorder/rename).
  // For roll-up rows, `field == rollupKey`.
  rollupKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, rollupKey])
}

// An uploaded document parsed into proposed field changes. The proposal is
// stored so the user can review a diff and confirm before anything is applied.
model ImportBatch {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  docType    String // payapp | pcolog | drawbudget
  filename   String
  status     String    @default("pending") // pending | applied | discarded
  proposal   Json
  uploadedBy String?
  appliedBy  String?
  createdAt  DateTime  @default(now())
  appliedAt  DateTime?

  @@index([projectId])
}

// Uploaded documents. Stored in the database (bytea) so the app needs no
// external object store; capped at a few MB per file at the API layer.
// Linked to a Task or Allowance, or neither (project-level PCO documents).
model Attachment {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  allowanceId String?
  allowance   Allowance? @relation(fields: [allowanceId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  size        Int
  data        Bytes
  uploadedBy  String?
  kind        String     @default("doc") // "doc" | "photo"
  description String?
  takenDate   DateTime? // for progress photos
  createdAt   DateTime   @default(now())

  @@index([projectId])
  @@index([taskId])
  @@index([allowanceId])
  @@index([kind])
}

// ---- Tasks ----------------------------------------------------------------
model Task {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  workstream String
  status     String    @default("On Track")
  priority   String    @default("Medium")
  lead       String? // team member initials
  deadline   DateTime?
  note       String?
  blocker    String?
  topIssue   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  attachments Attachment[]

  @@index([projectId])
}

// ---- Hard/soft cost snapshot ----------------------------------------------
model FinancialSnapshot {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asOfDate  DateTime

  originalBudget       Float?
  approvedChanges      Float?
  reallocationsFromTI  Float?
  currentBudget        Float?

  commitments          Float?
  nonContractedInvoiced Float?
  ffeAllowance         Float?
  currentCommitments   Float?
  uncommittedBudget    Float?

  costsToDate          Float?
  unspentCommitments   Float?

  allowances                       Float?
  pendingCosPcos                   Float?
  forecasted                       Float?
  overUnderBeforeContingency       Float?
  projectedFinalCost               Float?
  contingencyNeeded                Float?
  contingencyBalance               Float?
  trendingContingencyAtCompletion  Float?
  contractorContingency            Float?

  pcosApprovedPendingCo    Float?
  pcosApprovedPendingCoQty Int?
  pcosPending              Float?
  pcosPendingQty           Int?
  totalPcos                Float?
  totalPcosQty             Int?
  cosApproved              Float?
  cosApprovedQty           Int?
  totalCos                 Float?
  totalCosQty              Int?

  softCostBudget              Float?
  softCostCommitments         Float?
  softCostContingency         Float?
  softCostUncommitted         Float?
  softCostContingencyBalance  Float?

  equityBudget     Float?
  equityRequested  Float?
  loanBudget       Float?
  loanRequested    Float?

  // From the latest GC pay application (G702)
  retainage         Float?
  currentPaymentDue Float?

  createdAt DateTime @default(now())

  @@index([projectId])
}

// ---- PCOs -----------------------------------------------------------------
model PcoSummary {
  id                  String  @id @default(cuid())
  projectId           String  @unique
  project             Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  totalPcos           Int?
  totalValue          Float?
  originalContractSum Float?
  currentContract     Float?
}

model PcoStatusBucket {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    String
  count     Int
  value     Float

  @@index([projectId])
}

model PcoReason {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reason        String
  count         Int
  value         Float
  pctOfApproved Float?

  @@index([projectId])
}

model PcoFundingSource {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source      String
  count       Int
  value       Float
  pctOfFunded Float?

  @@index([projectId])
}

// Individual potential change orders — the editable PCO log.
model Pco {
  id                    String   @id @default(cuid())
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number                String?
  scope                 String
  status                String   @default("Pending") // Approved | Pending | ROM | Voided
  value                 Float?
  oco                   String?
  gcFunding             String? // CO to Contract | GC Allowance | Contractor Contingency
  creFunding            String   @default("None/Other")
  contractorAllowance   Float?
  buyout                Float?
  contractorContingency Float?
  recoupableCosts       Float?
  reason                String   @default("Other") // Owner Change | Tenant Request | Design Error | Other
  notes                 String?
  orderIndex            Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([projectId])
}

model Allowance {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  amount      Float
  used        Float
  balance     Float
  pcReference String?

  attachments Attachment[]

  @@index([projectId])
}

// ---- Commitments ----------------------------------------------------------
model Commitment {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor            String
  contract          String?
  startDate         DateTime?
  endDate           DateTime?
  status            String    @default("Approved")
  originalContract  Float?
  changeOrderAmount Float?
  totalContract     Float?
  pendingCos        Float?
  invoiced          Float?
  remaining         Float?

  @@index([projectId])
}

// ---- Schedule -------------------------------------------------------------
model Milestone {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seq          Int?
  description  String
  baseDate     DateTime?
  contractDate DateTime?
  currentDate  DateTime?
  varianceDays Int?

  @@index([projectId])
}

model DesignIssuance {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description  String
  receivedDate DateTime?

  @@index([projectId])
}

model LookaheadItem {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String

  @@index([projectId])
}

model WeeklyStatus {
  id              String  @id @default(cuid())
  projectId       String
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  week            String
  orderIndex      Int
  onTrack         Int
  needsAttention  Int
  blocked         Int
  done            Int

  @@index([projectId])
}
