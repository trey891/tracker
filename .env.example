# --- Database -----------------------------------------------------------
# Any Postgres connection string. For a hosted DB (Neon, Supabase, RDS) paste
# the POOLED connection URL here. For local dev you can run:
#   docker compose up -d      (see docker-compose.yml)
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse?schema=public"

# Direct (non-pooled) connection, used for schema push / seeding.
#   - Neon/Supabase: use the DIRECT connection string (not the pooled one).
#   - Local Postgres: set this to the SAME value as DATABASE_URL.
DIRECT_URL="postgresql://pulse:pulse@localhost:5432/pulse?schema=public"

# --- Auth (Auth.js / NextAuth v5) --------------------------------------
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# The seed sets every team member's password to this value. Change it before
# seeding a shared/production database, and rotate passwords after first login.
SEED_PASSWORD="pulse-changeme-2026"

# --- iOS app (Capacitor) — optional -------------------------------------
# The URL the native shell loads. Also read by capacitor.config.ts.
CAP_SERVER_URL="https://your-app.vercel.app"

# --- Push notifications (APNs) — optional, set on the server/Vercel -----
# Leave unset and push simply no-ops. To enable, create an APNs Auth Key
# (.p8) in the Apple Developer portal and fill these in:
# APNS_KEY_ID="XXXXXXXXXX"
# APNS_TEAM_ID="YYYYYYYYYY"
# APNS_BUNDLE_ID="com.crescent.pulse"
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_PRODUCTION="true"   # true for TestFlight / App Store builds
